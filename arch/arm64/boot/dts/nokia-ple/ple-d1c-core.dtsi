/*
 * Nokia 6 (D1C/PLE) boot-critical platform data.
 *
 * Nokia hardware authority:
 *   HMD commit d548dae4af7fa5a75be88ce2e93f95ad4c867777
 *   arch/arm/boot/dts/qcom/msm8937-fih-D1C-v0.dtsi
 *   arch/arm/boot/dts/qcom/msm8937-pinctrl-D1C.dtsi
 *   arch/arm/boot/dts/qcom/components/memmap/memmap_8937_v0.dtsi
 *   arch/arm/boot/dts/qcom/components/memmap/msm8937-memory-pstore.dtsi
 *   fs/pstore/ram.c
 *
 * The Linux 4.19 Qualcomm substrate supplies CPUs, interrupt controllers,
 * timers, clocks, the PM8937 regulator graph, and the SDHCI controllers.  This
 * file translates only the exact D1C board-level overrides needed for early
 * console, persistent logs, eMMC, SD-card access, K03 USB recovery, and the
 * K04 recovery display/input path, and the K05 battery/power policy. Audio,
 * camera, radio, sensors, fingerprint, NFC, and non-backlight LEDs remain
 * deferred.
 */

#include "../vendor-legacy/qcom/pmi8950.dtsi"
#include "ple-d1c-batterydata.dtsi"
#include "ple-panel-fih-ili7807e-1080p-video.dtsi"
#include "ple-d1c-display-input.dtsi"

/*
 * The 4.19 generic PMI8950 description assumes a QUSB PHY. D1C retains the
 * legacy HSUSB OTG block, which is also the exact MSM8937/PMI8950 DP/DM
 * provider used by the registered 4.19 reference. K05 restores the exact HMD
 * D1C battery profiles, charger limits, HVDCP prohibition, and the high/low
 * compensation policy before enabling charging.
 */
&qpnp_smbcharger {
	dpdm-supply = <&usb_otg>;
	qcom,battery-data = <&d1c_batterydata>;
	qcom,float-voltage-mv = <4400>;
	qcom,fastchg-current-comp = <1200>;
	qcom,float-voltage-comp = <16>;
	qcom,thermal-mitigation = <3000 1200 600 0>;
	qcom,iterm-ma = <100>;
	qcom,charging-timeout-mins = <1536>;
	qcom,precharging-timeout-mins = <192>;
	qcom,override-usb-current;
	qcom,bmd-pin-src = "bpd_thm";
	fih,disable_hvdcp_charge;
	fih,high-low-comp-set = <1>;
	status = "okay";
};

&qpnp_fg {
	qcom,battery-data = <&d1c_batterydata>;
	qcom,bad-battery-detection-enable;
	qcom,fg-cutoff-voltage-mv = <3300>;
	qcom,resume-soc = <95>;
	qcom,fg-iterm-ma = <150>;
	qcom,fg-chg-iterm-ma = <100>;
	qcom,hold-soc-while-full;
	qcom,cold-hot-jeita-hysteresis = <6 6>;
	qcom,ext-sense-type;
	qcom,vbat-estimate-diff-mv = <100>;
	status = "okay";
};

&flash_led {
	status = "disabled";
};

&pmi_haptic {
	qcom,actuator-type = <0>;
	qcom,vmax-mv = <3000>;
	status = "okay";
};

&reserved_memory {
	/* Exact FIH 0xc3200000..0xc3afffff shared-memory reservation. */
	fih_mem: fih_region@c3200000 {
		compatible = "removed-dma-pool";
		reg = <0x0 0xc3200000 0x0 0x00900000>;
		no-map;
	};

	/*
	 * The stock 3.18 driver hard-coded this exact 1-MiB area and geometry.
	 * Linux 4.19 consumes the same reservation through the ramoops binding.
	 */
	ramoops: ramoops@c3b00000 {
		compatible = "ramoops";
		reg = <0x0 0xc3b00000 0x0 0x00100000>;
		record-size = <0x00001000>;
		console-size = <0x00040000>;
		ftrace-size = <0x00001000>;
		pmsg-size = <0x00001000>;
		no-map;
	};
};

/* Match the Android 9 FIH partition contract; PLE has no vendor partition. */
&firmware {
	android {
		fstab {
			vendor {
				status = "disabled";
			};

			system {
				fsmgr_flags = "wait,verify";
				status = "okay";
			};
		};
	};
};

/* HMD D1C disables the GPIO67 card-detect pull-up while the slot is active. */
&tlmm {
	ple_sdhc2_cd_pin {
		ple_sdc2_cd_on: cd_on {
			mux {
				pins = "gpio67";
				function = "gpio";
			};

			config {
				pins = "gpio67";
				drive-strength = <2>;
				bias-disable;
			};
		};
	};
};

&usb_otg {
	qcom,floated-charger-enable;
	status = "okay";
};

/*
 * K06 Recovery boundary: SMEM and the RPM transport stay available because
 * the regulator graph depends on them.  Modem and ADSP firmware boot are not
 * needed by Recovery and remain quiesced until their exact Android 9 firmware
 * and userspace contracts are validated together in Phase 9.
 */
&pil_mss {
	status = "disabled";
};

&{/soc/qcom,lpass@c200000} {
	status = "disabled";
};

&bam_dmux {
	status = "disabled";
};

&{/soc/qcom,smdpkt} {
	status = "disabled";
};

&{/soc/smd/modem} {
	status = "disabled";
};

&{/soc/smd/adsp} {
	status = "disabled";
};

&{/soc/qcom,smsm/modem@1} {
	status = "disabled";
};

&{/soc/qcom,smsm/adsp@2} {
	status = "disabled";
};

&{/soc/smp2p-modem} {
	status = "disabled";
};

&{/soc/smp2p-adsp} {
	status = "disabled";
};

&{/soc/qcom,smp2p_sleepstate} {
	status = "disabled";
};

&adsp_loader {
	status = "disabled";
};

&{/soc/qcom,msm_fastrpc} {
	status = "disabled";
};

&{/soc/qcom,adsprpc-mem} {
	status = "disabled";
};

&{/soc/qcom,rmtfs_sharedmem@00000000} {
	status = "disabled";
};

&{/soc/modem_etm0} {
	status = "disabled";
};

&{/soc/audio_etm0} {
	status = "disabled";
};

/*
 * The generic HMD MSM8937 tree described a Pericom controller on QUP2, but
 * the exact D1C EVT overlay shared by all four approved variants explicitly
 * disabled it. The 4.19 substrate has no Pericom child, so use the stock
 * PMIC-controlled HSUSB role/VBUS path. D1C also disables the inherited WSA
 * codecs on this bus; audio remains deferred to K08.
 */
&wsa881x_i2c_f {
	status = "disabled";
};

&wsa881x_i2c_45 {
	status = "disabled";
};

&blsp1_uart2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart_console_active>;
};

&sdhc_1 {
	vdd-supply = <&pm8937_l8>;
	qcom,vdd-voltage-level = <2900000 2900000>;
	qcom,vdd-current-level = <200 570000>;

	vdd-io-supply = <&pm8937_l5>;
	qcom,vdd-io-always-on;
	qcom,vdd-io-lpm-sup;
	qcom,vdd-io-voltage-level = <1800000 1800000>;
	qcom,vdd-io-current-level = <200 325000>;

	pinctrl-names = "active", "sleep";
	pinctrl-0 = <&sdc1_clk_on &sdc1_cmd_on &sdc1_data_on &sdc1_rclk_on>;
	pinctrl-1 = <&sdc1_clk_off &sdc1_cmd_off &sdc1_data_off &sdc1_rclk_off>;

	qcom,clk-rates = <400000 20000000 25000000 50000000 100000000
			  192000000 384000000>;
	qcom,nonremovable;
	qcom,bus-speed-mode = "HS400_1p8v", "HS200_1p8v", "DDR_1p8v";
	status = "okay";
};

&sdhc_2 {
	vdd-supply = <&pm8937_l11>;
	qcom,vdd-voltage-level = <2950000 2950000>;
	qcom,vdd-current-level = <15000 800000>;

	vdd-io-supply = <&pm8937_l12>;
	qcom,vdd-io-voltage-level = <1800000 2950000>;
	qcom,vdd-io-current-level = <200 22000>;

	pinctrl-names = "active", "sleep";
	pinctrl-0 = <&sdc2_clk_on &sdc2_cmd_on &sdc2_data_on
		     &ple_sdc2_cd_on>;
	pinctrl-1 = <&sdc2_clk_off &sdc2_cmd_off &sdc2_data_off>;

	cd-gpios = <&tlmm 67 0x1>;
	qcom,clk-rates = <400000 20000000 25000000 50000000 100000000
			  200000000>;
	qcom,bus-speed-mode = "SDR12", "SDR25", "SDR50", "DDR50", "SDR104";
	status = "okay";
};
