&{/soc/qcom,msm-dai-tdm-quin-tx} { status = "disabled"; };
&{/soc/qcom,msm-dai-tdm-sen-rx} { status = "disabled"; };
&{/soc/qcom,msm-dai-tdm-sen-tx} { status = "disabled"; };
&{/soc/qcom,msm-dai-q6-spdif-pri-rx} { status = "disabled"; };
&{/soc/qcom,msm-dai-q6-spdif-pri-tx} { status = "disabled"; };
