&{/soc/qcom,msm-dai-tdm-tert-tx} { status = "disabled"; };
&{/soc/qcom,msm-dai-tdm-quat-rx} { status = "disabled"; };
&{/soc/qcom,msm-dai-tdm-quat-tx} { status = "disabled"; };
