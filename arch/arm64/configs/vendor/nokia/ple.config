CONFIG_LOCALVERSION="-ple"
# CONFIG_LOCALVERSION_AUTO is not set

# Android 16 kernel config contract (kernel/configs/t/android-4.19).
CONFIG_HID_PLAYSTATION=y
CONFIG_PLAYSTATION_FF=y
CONFIG_HIDRAW=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_SCH_TBF=y
# First-boot compatibility: keep the known-working MSM8937 non-LTO baseline.
# Reintroduce hardening one feature at a time only after Recovery reaches ADB.
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG is not set
# CONFIG_THINLTO is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_SHADOW_CALL_STACK is not set
# CONFIG_KFENCE is not set

# PLE first-boot diagnostics. Hardware nodes remain stock-derived only.
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y

# Nokia 619F LK appends skip_initramfs even to fastboot boot images.
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y

# K03 USB presence detection; charging policy comes from the exact PLE DT.
CONFIG_QPNP_SMBCHARGER=y

# K04 exact HMD ILI2121X protocol-3.x recovery input.
CONFIG_TOUCHSCREEN_ILI210X=y

# Exact PLE619F Goodix physical Home/Back/Recents decoder ABI.
CONFIG_PLE_GOODIX=y

# Exact PLE619F ARM32 camera ioctl ABI is the maintained 3.18-derived stack,
# not the newer camera_v2 layout (sensor_info164 vs172, slave_info1568 vs1588).
# Build one camera stack only; no Xiaomi machine identity is selected.
CONFIG_MSMB_CAMERA_LEGACY=y
# CONFIG_MSMB_CAMERA_ENABLE is not set

# Wi-Fi: maintained 4.19 Pronto/Prima implementation, with exact PLE WCNSS
# DT nodes restored together. Do not select the unrelated qcacld-3.0 chipset.
CONFIG_PRONTO_WLAN=y
CONFIG_WCNSS_CORE=y
CONFIG_WCNSS_CORE_PRONTO=y
CONFIG_WCNSS_REGISTER_DUMP_ON_BITE=y

# PLE stock boot-image convention.
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE_NAMES="nokia-ple/msm8937-pmi8950-fih-PLE-DVT nokia-ple/msm8937-pmi8950-fih-PLE-EVT nokia-ple/msm8937-pmi8950-fih-PLE-PVT"
